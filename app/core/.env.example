# ===================== 下载器 =====================
# qBittorrent WebUI 地址
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# Web API Key（qb 5.2.0+，WebUI 设置 → 身份验证 → Web API Key）。
# 填了就走 Bearer 鉴权，不再登录换 Cookie，上面的账号密码可留空
QBITTORRENT_APIKEY=
# 下载保存路径，需与 qb 内可见的路径一致
QBITTORRENT_DOWNLOAD_PATH=
QBITTORRENT_CATEGORY=
# 使用自签证书或反代时保持 False
QBITTORRENT_VERIFY_CERT=False

TRANSMISSION_URL=
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=
TRANSMISSION_DOWNLOAD_PATH=
TRANSMISSION_LABEL=

# ---- 转移做种（qBittorrent → Transmission）----
# 把 qb 里已下载完的种子交给 tr 继续做种，qb 腾出来干新活。
# 文件不移动，两个下载器指向同一份，从 qb 删任务时永不删文件
SEED_TRANSFER_ENABLED=False
# 自动转移的间隔（分钟）
SEED_TRANSFER_INTERVAL=60
# 一轮最多转移多少个。每个都要触发一次 tr 校验，校验吃磁盘 IO。
# 存量多又不怕 IO 时可调大，0 表示不限
SEED_TRANSFER_BATCH_LIMIT=20
# 转移后从 qb 删掉源任务（只删任务不删文件）。False 则两边同时做种
SEED_TRANSFER_DELETE_SOURCE=True
# 只转移这些分类/标签的种子，逗号分隔。都留空表示全部已完成任务
SEED_TRANSFER_CATEGORIES=
SEED_TRANSFER_TAGS=
# 转移进 tr 的种子打的标签，留空则用 TRANSMISSION_LABEL
SEED_TRANSFER_LABEL=cinefold-transfer
# 两个下载器挂载点不同时的路径映射，"qb前缀:tr前缀"，多组用逗号分隔
# 例：/downloads:/data/downloads
SEED_TRANSFER_PATH_MAP=

# ---- qBittorrent 连接自愈 ----
# qb 偶发卡死（WebAPI 不响应但进程还在）时自动重启它的容器。
# 默认关闭：重启会让正在下载的任务断连重试
QB_AUTOHEAL_ENABLED=False
# 连续多少次「连接失败」才重启。403、种子不存在这类业务错误不计数，
# 一次成功响应即清零
QB_AUTOHEAL_FAILURES=3
# 两次重启之间的最短间隔（分钟）。qb 重启后要几十秒才能响应 WebAPI，
# 没有冷却会连着重启好几轮
QB_AUTOHEAL_COOLDOWN=15
# 重启后推送通知
QB_AUTOHEAL_NOTIFY=True
# Docker 地址。名字带 _URL 后缀是为了不和 Docker 官方的 DOCKER_HOST 撞车 ——
# 那个变量会被 docker CLI 等工具读取，占用它会引起意外行为。
# qb 与本容器同机：unix:///var/run/docker.sock，
#   并在 docker-compose.yml 里挂上 /var/run/docker.sock:/var/run/docker.sock
#   （不能加 :ro，重启容器要往 socket 写）
# qb 在另一台机器：tcp://192.168.3.11:2375（2375 无鉴权，只能在可信内网开）
DOCKER_HOST_URL=unix:///var/run/docker.sock
# qBittorrent 的容器名或容器 ID
DOCKER_CONTAINER_QBITTORRENT=

# 迅雷远程下载，凭证需从浏览器抓取
THUNDER_URL=
THUNDER_FILE_ID=
THUNDER_AUTHORIZATION=

# ===================== 媒体库 =====================
EMBY_URL=
EMBY_API_KEY=
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER=
PLEX_URL=
PLEX_TOKEN=

# ===================== 媒体联动 =====================
# 按 inode 反查源文件时的扫描范围。必须与下载目录在同一挂载卷，
# 否则刮削工具建不出硬链接，联动无从谈起。
# 可以设成分类目录的上一层（如 /volume3/h_video），把多个分类都纳入反查范围。
MEDIALINK_LIBRARY_PATH=
# 刮削工具实际写入硬链接的目录（如 /volume3/h_video/日本AV）。留空则等同库根。
# 库根设成上一层时务必填这个 —— 该目录受保护，不会在清空后被当成空目录删掉
# （删了 Emby 会认为整个媒体库掉线）。也会在「监控目录」页以受保护条目列出。
MEDIALINK_SCRAPE_DIR=
# 媒体服务器删除影片时，同步删除下载器种子与磁盘文件。
# 删除不可逆：开启前建议先带 ?dry_run=1 调用 /webhook/emby 确认反查结果正确。
MEDIALINK_DELETE_ENABLED=false
# webhook 密钥。请求需带 X-Cinefold-Token 头（或 ?token= 参数）。
# 留空则不校验 —— 删除端点会真的删文件，强烈建议设置。
MEDIALINK_WEBHOOK_TOKEN=

# ===================== 监控目录 =====================
# 监控目录本身在页面上配置（系统 → 监控目录），这里只有全局的删除宽限期。
#
# 文件从监控目录消失后，先扣留观察这么多秒再决定是否删除。宽限期内若同 inode
# 的文件在别处出现，判定为移动/改名 —— 只改关联记录，不动硬链接，Emby 的
# 观看记录得以保留。也能挡住网络存储瞬时不可达造成的误删。
# 默认 1800（30 分钟）。设为 0 则发现即删，不推荐。
WATCHDIR_DELETE_GRACE=1800

# ===================== PT 站点 =====================
MTEAM_API_KEY=
# Rousi 账号：填了会自动登录并在 token 过期时续期
ROUSI_USERNAME=
ROUSI_PASSWORD=
# 手动 token（浏览器 F12 执行 localStorage.getItem('token')）
# 填了账号密码时可留空
ROUSI_TOKEN=
# 取自 announce 地址中间那段，用于下载种子文件
ROUSI_PASSKEY=
PTT_COOKIE=
NICEPT_COOKIE=

# ===================== 自定义 BT 源 =====================
# 返回格式需为 {"data": [Torrent, ...]}，详见 README
BT_URL=
BT_METHOD=get
# 关掉后 BT 源仍参与搜索，但自动下载不会选它的种子
BT_AUTO_DOWNLOAD=True
BT_HEADER=
BT_JSON_DATA=

# ===================== 通知 =====================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SPOILER=False
# 允许操作的用户 ID，多个用 | 分隔，留空则不限制
TELEGRAM_WHITELIST=
# 上行消息接收方式：webhook（需公网 HTTPS，配合 EXTERNAL_DOMAIN）或 polling（长轮询）
TELEGRAM_RECEIVE_MODE=webhook

# --- 上行消息的番号订阅过滤（TG / 企业微信共用）---
# 番号前缀白名单，逗号分隔（如 SSIS,NHDTB）。非空时只订阅名单内的前缀
MSG_ALLOW_PREFIXES=
# 番号前缀黑名单，优先于白名单
MSG_BLOCK_PREFIXES=
# 单条消息最多订阅几个番号，0 表示不限
MSG_MAX_CODES=50
# 订阅后立即在后台检索 PT 并推给下载器；关闭则等每日订阅下载任务
MSG_AUTO_DOWNLOAD=False

WECHAT_CORP_ID=
WECHAT_CORP_SECRET=
WECHAT_AGENT_ID=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_TO_USER=@all
WECHAT_PROXY=
WECHAT_PHOTO=
WECHAT_BANNER=False

# ===================== 翻译 =====================
# OpenAI 兼容接口，优先级高于百度与谷歌
OPENAI_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
BAIDU_APP_ID=
BAIDU_API_KEY=
GOOGLE_API_KEY=

# ===================== AI 助手 =====================
# 侧边悬浮的对话入口，可直接问系统当前情况（只读，不会改任何东西）。
# 三项留空则沿用上面翻译的 OPENAI_* 配置。助手要做工具调用，
# 建议用比翻译更强的模型
AGENT_ENABLED=True
AGENT_URL=
AGENT_MODEL=
AGENT_API_KEY=

# ===================== 网络 =====================
# 支持 http:// 与 socks5://
PROXY=
# 外网访问地址，用于消息中的链接与 Telegram webhook 回调
EXTERNAL_DOMAIN=
# 自建反爬绕过服务（FlareSolverr 等），直连被拦时改走它
BYPASS_URL=
# 图片代理的额外允许域名，逗号分隔；与内置白名单合并
IMAGE_PROXY_HOSTS=

# ===================== 过滤与排序 =====================
DEFAULT_FILTER='{"only_chinese": false, "only_uc": false, "exclude_uc": false, "only_uhd": false, "only_free": false, "exclude_uhd": true, "only_vr": false, "exclude_vr": true, "include_keywords": "", "exclude_keywords": "", "min_size": "", "max_size": "", "min_seeders": "", "max_seeders": ""}'
# 逗号分隔，! 前缀表示降权
DEFAULT_SORT='free,chinese,uc,!uc,site,seeders,!uhd,uhd'
# 优先选哪个 PT 站的种子，逗号分隔可给多个。需 DEFAULT_SORT 里含 site
PRIMARY_SITE=
MAX_ACTOR=3

# ===================== 资源站 =====================
# ALL / javdb / javbus
MAIN_SITE=ALL
JAVDB_HOST=https://javdb.com
# 图片显示模式：BLUR / VISIBLE / INVISIBLE
IMAGE_MODE=BLUR
ENABLE_PHOTO_CACHE=False
# 媒体库中已存在的番号跳过下载
ENABLE_AUTO_COMPLETE=True

# ===================== 定时任务（crontab 格式）=====================
DOWNLOAD_SCHEDULE_TIME='0 22 * * *'
ACTOR_SCHEDULE_TIME='0 21 * * *'
RANK_SCHEDULE_TIME='0 20 * * *'
BRAND_SCHEDULE_TIME='30 20 * * *'
SYNC_HOT_TIME='0 */2 * * *'
SYNC_BRANDS_TIME='10 */2 * * *'
SYNC_ACTORS_TIME='20 */2 * * *'
SYNC_NEWS='45 */5 * * *'
FILL_EMPTY_IMAGE_TIME='30 */12 * * *'

# 榜单自动订阅页数，0 表示不订阅
RANK_PAGE=0
# daily / weekly / monthly
RANK_TYPE=
# 同步哪些厂牌的新片：all 或逗号分隔，如 s1,moodyz
# 只把番号收进库供浏览，不会订阅也不会下载。留空则不同步
BRAND_TYPE=
# 自动订阅哪些厂牌的新片：all 或逗号分隔。会进入下载流程
# 与 BRAND_TYPE 相互独立，留空则不订阅
BRAND_SUBSCRIBE=
# 只订阅最近几天发布的，避免首次配置时订上一大批
BRAND_SUBSCRIBE_DAYS=3

# ===================== 云盘 =====================
CLOUDNAS_URL=
CLOUDNAS_USERNAME=
CLOUDNAS_PASSWORD=
CLOUDNAS_SAVEPATH=/115open

# ===================== 数据库 =====================
# 留空则用 /data 下的 SQLite 文件，无需额外服务
# 接 PostgreSQL 时填写，例如：
# DATABASE_URL=postgresql://cinefold:password@postgres:5432/cinefold
DATABASE_URL=
# 以下仅对外部数据库生效
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# 打印 SQL，排查问题时开
DB_ECHO=False

# ===================== Redis =====================
# 留空则缓存落到数据库的 cache 表，定时任务只存内存
# REDIS_URL=redis://redis:6379/0
REDIS_URL=
# 缓存过期秒数，0 表示不过期
REDIS_CACHE_TTL=86400
# 定时任务状态持久化到 Redis，重启后不丢失执行进度
REDIS_JOB_STORE=False

# ===================== 系统 =====================
# 留空则首次启动自动生成并写回
SECRET_KEY=

# ===================== 登录方式 =====================
# --- 单点登录 (OIDC) ---
# 回调地址填 https://<外网地址>/api/v1/auth/oidc/callback
OIDC_ENABLED=False
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=SSO
OIDC_SCOPE=openid profile email
# Claim 映射
OIDC_USERNAME_CLAIM=preferred_username
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
# 所有 SSO 用户都登录到这个本地账号，单用户部署填 admin
OIDC_BIND_USERNAME=

# --- Passkey (WebAuthn) ---
# 站点域名，不含端口与协议。留空则从请求推断
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=cinefold
# 检测新版本用。镜像公开时可留空；私有镜像需要带 read:packages 权限的 token
GITHUB_TOKEN=
# GitHub 加速代理，直连不通时填，如 https://edgeone.gh-proxy.org/。留空走直连
GITHUB_PROXY=
# 走代理时是否携带上面的 Token。默认 False（代理是第三方机器，不该看到凭证）；
# 私有仓库不带 Token 一律返回 404，那种情况下必须打开
GITHUB_PROXY_SEND_TOKEN=False
