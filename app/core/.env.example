# ===================== 下载器 =====================
# qBittorrent WebUI 地址
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# 下载保存路径，需与 qb 内可见的路径一致
QBITTORRENT_DOWNLOAD_PATH=
QBITTORRENT_CATEGORY=
# 使用自签证书或反代时保持 False
QBITTORRENT_VERIFY_CERT=False

TRANSMISSION_URL=
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=
TRANSMISSION_DOWNLOAD_PATH=
TRANSMISSION_LABEL=

# 迅雷远程下载，凭证需从浏览器抓取
THUNDER_URL=
THUNDER_FILE_ID=
THUNDER_AUTHORIZATION=

# ===================== 媒体库 =====================
EMBY_URL=
EMBY_API_KEY=
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER=
PLEX_URL=
PLEX_TOKEN=

# ===================== PT 站点 =====================
MTEAM_API_KEY=
# Rousi 账号：填了会自动登录并在 token 过期时续期
ROUSI_USERNAME=
ROUSI_PASSWORD=
# 手动 token（浏览器 F12 执行 localStorage.getItem('token')）
# 填了账号密码时可留空
ROUSI_TOKEN=
# 取自 announce 地址中间那段，用于下载种子文件
ROUSI_PASSKEY=
PTT_COOKIE=
NICEPT_COOKIE=

# ===================== 自定义 BT 源 =====================
# 返回格式需为 {"data": [Torrent, ...]}，详见 README
BT_URL=
BT_METHOD=get
BT_HEADER=
BT_JSON_DATA=

# ===================== 通知 =====================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SPOILER=False
# 允许操作的用户 ID，多个用 | 分隔，留空则不限制
TELEGRAM_WHITELIST=
# 上行消息接收方式：webhook（需公网 HTTPS，配合 EXTERNAL_DOMAIN）或 polling（长轮询）
TELEGRAM_RECEIVE_MODE=webhook

# --- 上行消息的番号订阅过滤（TG / 企业微信共用）---
# 番号前缀白名单，逗号分隔（如 SSIS,NHDTB）。非空时只订阅名单内的前缀
MSG_ALLOW_PREFIXES=
# 番号前缀黑名单，优先于白名单
MSG_BLOCK_PREFIXES=
# 单条消息最多订阅几个番号，0 表示不限
MSG_MAX_CODES=50
# 订阅后立即在后台检索 PT 并推给下载器；关闭则等每日订阅下载任务
MSG_AUTO_DOWNLOAD=False

WECHAT_CORP_ID=
WECHAT_CORP_SECRET=
WECHAT_AGENT_ID=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_TO_USER=@all
WECHAT_PROXY=
WECHAT_PHOTO=
WECHAT_BANNER=False

# ===================== 翻译 =====================
# OpenAI 兼容接口，优先级高于百度与谷歌
OPENAI_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
BAIDU_APP_ID=
BAIDU_API_KEY=
GOOGLE_API_KEY=

# ===================== 网络 =====================
# 支持 http:// 与 socks5://
PROXY=
# 外网访问地址，用于消息中的链接与 Telegram webhook 回调
EXTERNAL_DOMAIN=
# 自建反爬绕过服务（FlareSolverr 等），直连被拦时改走它
BYPASS_URL=
# 图片代理的额外允许域名，逗号分隔；与内置白名单合并
IMAGE_PROXY_HOSTS=

# ===================== 过滤与排序 =====================
DEFAULT_FILTER='{"only_chinese": false, "only_uc": false, "exclude_uc": false, "only_uhd": false, "only_free": false, "exclude_uhd": true, "only_vr": false, "exclude_vr": true, "include_keywords": "", "exclude_keywords": "", "min_size": "", "max_size": ""}'
# 逗号分隔，! 前缀表示降权
DEFAULT_SORT='free,chinese,uc,!uc,site,seeders,!uhd,uhd'
# 优先选哪个 PT 站的种子，逗号分隔可给多个。需 DEFAULT_SORT 里含 site
PRIMARY_SITE=
MAX_ACTOR=3

# ===================== 资源站 =====================
# ALL / javdb / javbus
MAIN_SITE=ALL
JAVDB_HOST=https://javdb.com
# 图片显示模式：BLUR / VISIBLE / INVISIBLE
IMAGE_MODE=BLUR
ENABLE_PHOTO_CACHE=False
# 媒体库中已存在的番号跳过下载
ENABLE_AUTO_COMPLETE=True

# ===================== 定时任务（crontab 格式）=====================
DOWNLOAD_SCHEDULE_TIME='0 22 * * *'
ACTOR_SCHEDULE_TIME='0 21 * * *'
RANK_SCHEDULE_TIME='0 20 * * *'
SYNC_HOT_TIME='0 */2 * * *'
SYNC_BRANDS_TIME='10 */2 * * *'
SYNC_ACTORS_TIME='20 */2 * * *'
SYNC_NEWS='45 */5 * * *'
FILL_EMPTY_IMAGE_TIME='30 */12 * * *'

# 榜单自动订阅页数，0 表示不订阅
RANK_PAGE=0
# daily / weekly / monthly
RANK_TYPE=
# 厂牌订阅：all 或逗号分隔，如 s1,moodyz
BRAND_TYPE=

# ===================== 云盘 =====================
CLOUDNAS_URL=
CLOUDNAS_USERNAME=
CLOUDNAS_PASSWORD=
CLOUDNAS_SAVEPATH=/115open

# ===================== 数据库 =====================
# 留空则用 /data 下的 SQLite 文件，无需额外服务
# 接 PostgreSQL 时填写，例如：
# DATABASE_URL=postgresql://byte_muse:password@postgres:5432/byte_muse
DATABASE_URL=
# 以下仅对外部数据库生效
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# 打印 SQL，排查问题时开
DB_ECHO=False

# ===================== Redis =====================
# 留空则缓存落到数据库的 cache 表，定时任务只存内存
# REDIS_URL=redis://redis:6379/0
REDIS_URL=
# 缓存过期秒数，0 表示不过期
REDIS_CACHE_TTL=86400
# 定时任务状态持久化到 Redis，重启后不丢失执行进度
REDIS_JOB_STORE=False

# ===================== 系统 =====================
# 留空则首次启动自动生成并写回
SECRET_KEY=
# 检测新版本用。镜像公开时可留空；私有镜像需要带 read:packages 权限的 token
GITHUB_TOKEN=
